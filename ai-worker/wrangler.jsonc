{
  "name": "tcv-ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcv-profiles",
      "database_id": "422b8c17-deaa-4fbd-a47c-c0891aecc8c6"
    }
  ],
  "ratelimits": [
    {
      "name": "GROQ_RATE_LIMIT",
      "namespace_id": "2026112501",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
